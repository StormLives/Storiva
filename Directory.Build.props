<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Product name and version are the same in every build of a release (code-signing metadata rules). Change
         Version only when preparing a release, together with the git tag (v0.3.0 -> 0.3.0). -->
    <Product>Storiva</Product>
    <Company>Storiva contributors</Company>
    <Authors>Storiva contributors</Authors>
    <Copyright>Copyright (c) 2026 Storiva contributors. MIT License.</Copyright>
    <Description>Windows desktop client for Amazon S3 and S3-compatible object storage (MinIO and others).</Description>
    <Version>0.3.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
</Project>
