# Normalize text files to LF in the repository; Windows checkouts get CRLF where Git is configured for it.
* text=auto

# Windows scripts and the solution keep CRLF in the working tree
*.ps1 text eol=crlf
*.sln text eol=crlf

# Binary assets
*.png binary
*.ico binary
*.jpg binary
*.gif binary

# Batch files must keep CRLF to run correctly in cmd.exe
*.bat text eol=crlf
*.cmd text eol=crlf
