<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-only: credential protection uses DPAPI (ProtectedData), which exists only on Windows. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Storiva.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Storiva.Core\Storiva.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.Core" Version="4.0.102.8" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
