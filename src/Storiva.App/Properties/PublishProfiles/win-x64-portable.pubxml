<?xml version="1.0" encoding="utf-8"?>
<!-- Portable build: one self-contained Storiva.exe for 64-bit Windows 10/11. It includes the .NET runtime, so the
     .NET 8 Desktop Runtime does not need to be installed. Used by build.bat, the installer and the CI release.
     dotnet publish src\Storiva.App\Storiva.App.csproj -c Release -p:PublishProfile=win-x64-portable -o <folder> -->
<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Native runtime libraries go inside the exe too (extracted on first run), so it is a single file. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Windows Forms does not support trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
